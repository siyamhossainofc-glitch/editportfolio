---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const basePath = baseUrl.replace(/\/+$/, "");
const routePath = Astro.url.pathname.replace(/\/+$/, "") || basePath;
const canonicalPath = routePath === basePath || routePath.startsWith(`${basePath}/`)
  ? routePath
  : `${basePath}/${routePath.replace(/^\/+/, "")}`;
const imagePath = `${basePath}/og.image.png`;
const canonicalUrl = Astro.site ? new URL(canonicalPath, Astro.site).href : undefined;
const socialImageUrl = Astro.site ? new URL(imagePath, Astro.site).href : undefined;
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  ...(canonicalUrl ? { url: canonicalUrl } : {}),
  isPartOf: { "@type": "WebSite", name: "Siyam Hossain Portfolio", ...(Astro.site ? { url: Astro.site.href } : {}) },
  about: {
    "@type": "Person",
    name: "Siyam Hossain",
    ...(socialImageUrl ? { image: socialImageUrl } : {}),
    sameAs: ["https://github.com/siyamhossainofc-glitch", "https://www.linkedin.com/in/siyam-hossain-a054a1373/"],
    address: { "@type": "PostalAddress", addressLocality: "Dhaka", addressCountry: "BD" },
    jobTitle: "Full-Stack Web Developer",
    email: "siyamhossainofc@gmail.com",
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <ClientRouter />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Siyam Hossain" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b0a0d" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/png" sizes="512x512" href={`${baseUrl}favicon.png`} />
    <link rel="apple-touch-icon" href={`${baseUrl}favicon.png`} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    <meta property="og:image:alt" content="Siyam Hossain portfolio preview" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Siyam Hossain Portfolio" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    <meta name="twitter:image:alt" content="Siyam Hossain portfolio preview" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>
<style is:global>
  @font-face { font-family: "Montserrat Variable"; src: url("../assets/montserrat-latin-wght-normal.woff2") format("woff2-variations"); font-weight: 100 900; font-style: normal; font-display: swap; }
  *,*::before,*::after { box-sizing: border-box; }
  html,body { margin: 0; min-height: 100%; }
  body { font-family: "Montserrat Variable",-apple-system,system-ui,sans-serif; }
  main { view-transition-name: route-content; }
  .skip-link { position: fixed; z-index: 200; top: .75rem; left: .75rem; padding: .7rem 1rem; border-radius: .5rem; color: #110d18; background: #b99bff; transform: translateY(-180%); transition: transform .2s ease; }
  .skip-link:focus-visible { transform: translateY(0); }
  ::-webkit-scrollbar { width: 10px; } ::-webkit-scrollbar-track { background: #0b0a0d; } ::-webkit-scrollbar-thumb { border: 2px solid #0b0a0d; border-radius: 999px; background: #37313f; } ::-webkit-scrollbar-thumb:hover { background: #7d61a6; }
  * { scrollbar-width: thin; scrollbar-color: #37313f #0b0a0d; }
  ::view-transition-group(route-content) { animation-duration: .34s; }
  ::view-transition-old(route-content) { animation: route-out .16s cubic-bezier(.4,0,1,1) both; }
  ::view-transition-new(route-content) { animation: route-in .28s cubic-bezier(.2,.7,.2,1) both; }
  ::view-transition-old(root),::view-transition-new(root) { animation-duration: .2s; }
  @keyframes route-out { to { opacity: 0; transform: translateY(-7px); filter: blur(2px); } }
  @keyframes route-in { from { opacity: 0; transform: translateY(9px); filter: blur(2px); } }
  .button:active,.project-link:active,.send-button:active { transform: scale(.975); }
  @media(prefers-reduced-motion:reduce) {
    ::view-transition-group(route-content),::view-transition-old(route-content),::view-transition-new(route-content),::view-transition-old(root),::view-transition-new(root) { animation: none !important; }
    .button,.project-link,.send-button,.skip-link { transition: none !important; }
    .button:active,.project-link:active,.send-button:active { transform: none; }
  }
</style>
<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const observedReveals = new WeakSet<Element>();
  let revealObserver: IntersectionObserver | null = null;

  const bindTilt = (element: HTMLElement) => {
    if (element.dataset.tiltBound || reducedMotion.matches || window.matchMedia("(pointer: coarse)").matches) return;
    element.dataset.tiltBound = "true";
    let frame = 0;
    element.addEventListener("pointermove", (event) => {
      if (reducedMotion.matches) { cancelAnimationFrame(frame); element.style.transform = ""; return; }
      const bounds = element.getBoundingClientRect();
      const rx = ((event.clientY - bounds.top) / bounds.height - .5) * -1.5;
      const ry = ((event.clientX - bounds.left) / bounds.width - .5) * 1.5;
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => { element.style.transform = `perspective(1100px) rotateX(${rx}deg) rotateY(${ry}deg)`; });
    });
    element.addEventListener("pointerleave", () => { cancelAnimationFrame(frame); element.style.transform = ""; });
  };

  const initPageMotion = () => {
    const targets = document.querySelectorAll<HTMLElement>("[data-reveal]");
    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach(bindTilt);
    if (reducedMotion.matches || !("IntersectionObserver" in window)) {
      targets.forEach((element) => element.classList.add("is-visible"));
      document.documentElement.classList.remove("motion-active");
      return;
    }
    document.documentElement.classList.add("motion-active");
    if (!revealObserver) {
      revealObserver = new IntersectionObserver((entries, currentObserver) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          currentObserver.unobserve(entry.target);
        });
      }, { threshold: .12, rootMargin: "0px 0px -35px 0px" });
    }
    targets.forEach((element) => {
      if (observedReveals.has(element) || element.classList.contains("is-visible")) return;
      observedReveals.add(element);
      revealObserver?.observe(element);
    });
  };
  document.addEventListener("astro:before-swap", () => { revealObserver?.disconnect(); revealObserver = null; });
  document.addEventListener("astro:page-load", initPageMotion);
  reducedMotion.addEventListener("change", (event) => {
    if (event.matches) {
      document.documentElement.classList.remove("motion-active");
      revealObserver?.disconnect();
      revealObserver = null;
      document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((element) => element.classList.add("is-visible"));
      document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((element) => { element.style.transform = ""; });
    } else initPageMotion();
  });
  initPageMotion();

  document.addEventListener("submit", async (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || form.id !== "contact-form") return;
    event.preventDefault();
    if (form.dataset.submitting === "true" || !form.reportValidity()) return;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const feedback = form.closest(".form-panel")?.querySelector<HTMLElement>("#form-message");
    if (!button || !feedback) return;
    form.dataset.submitting = "true";
    form.setAttribute("aria-busy", "true");
    const defaultLabel = button.textContent?.trim() || "Send message";
    button.disabled = true;
    button.textContent = "Sending…";
    feedback.hidden = true;
    feedback.className = "form-message";
    try {
      const response = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
      if (!response.ok) throw new Error("Message submission failed");
      form.reset();
      form.hidden = true;
      form.style.display = "none";
      feedback.textContent = "Thank you! Your message has been sent successfully.";
      feedback.classList.add("form-success");
      feedback.hidden = false;
    } catch {
      feedback.textContent = "Sorry, something went wrong. Please try again or contact me by email.";
      feedback.classList.add("form-error");
      feedback.hidden = false;
      button.disabled = false;
      button.textContent = defaultLabel;
      form.dataset.submitting = "false";
      form.removeAttribute("aria-busy");
    }
  });
</script>

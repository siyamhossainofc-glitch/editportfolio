---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Experience from "@/components/experience.astro";
import Education from "@/components/education.astro";
import Footer from "@/components/footer.astro";
---
<Layout title="Experience | Siyam Hossain — Full-Stack Web Developer" description="See Siyam Hossain's practical web development training, education, and continuing learning journey.">
  <Nav />
  <main id="main-content" class="experience-page">
    <section class="experience-intro content-wrap" data-reveal>
      <p class="eyebrow"><span class="status-dot"></span> Journey / Learning</p>
      <h1>Built on practice.<br /><span>Growing through curiosity.</span></h1>
      <p>My practical web development training, academic background, and continued learning.</p>
    </section>
    <Experience />
    <Education />
  </main>
  <Footer />
</Layout>
<style>
  .content-wrap { width:min(1180px,calc(100% - 3rem)); margin:0 auto; }.experience-intro { padding:9rem 0 2.5rem; color:#f1eff5; }
  .eyebrow { display:flex; align-items:center; gap:.65rem; color:#a9a4b0; font-size:.72rem; letter-spacing:.13em; text-transform:uppercase; }.status-dot { width:.45rem; height:.45rem; border-radius:50%; background:#a476ff; box-shadow:0 0 15px #a476ff77; }
  .experience-intro h1 { margin-top:1.5rem; font-size:clamp(2.8rem,7vw,6rem); font-weight:450; line-height:1; letter-spacing:-.07em; }.experience-intro h1 span { color:#b99bff; }.experience-intro > p:last-child { max-width:560px; margin-top:1.2rem; color:#a9a5af; font-size:1rem; line-height:1.8; }
  @media(max-width:700px) { .content-wrap { width:calc(100% - 2.25rem); }.experience-intro { padding-top:7.5rem; }.experience-intro h1 { font-size:clamp(2.7rem,12vw,4.6rem); } }
</style>

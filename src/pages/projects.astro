---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Projects from "@/components/projects.astro";
import Footer from "@/components/footer.astro";
---
<Layout title="Projects | Siyam Hossain — Full-Stack Web Developer" description="Review selected SkillBridge and POS Management case studies built with Laravel, React, PHP, MySQL, and JavaScript.">
  <Nav />
  <main id="main-content">
    <section class="projects-intro content-wrap" data-reveal>
      <p class="eyebrow"><span class="status-dot"></span> Selected work / Case studies</p>
      <h1>Work, <span>in context.</span></h1>
      <p>A closer look at the purpose, scope, and tools behind these projects.</p>
    </section>
    <Projects />
  </main>
  <Footer />
</Layout>
<style>
  .projects-intro { width:min(1180px,calc(100% - 3rem)); margin:0 auto; padding:9rem 0 2rem; color:#f1eff5; }
  .eyebrow { display:flex; align-items:center; gap:.65rem; color:#a9a4b0; font-size:.72rem; letter-spacing:.13em; text-transform:uppercase; }
  .status-dot { width:.45rem; height:.45rem; border-radius:50%; background:#a476ff; box-shadow:0 0 15px #a476ff77; }
  .projects-intro h1 { margin-top:1.5rem; font-size:clamp(3rem,7.5vw,6.8rem); font-weight:450; line-height:.98; letter-spacing:-.07em; }.projects-intro h1 span { color:#b99bff; }
  .projects-intro > p:last-child { max-width:560px; margin-top:1.2rem; color:#a9a5af; font-size:1.05rem; line-height:1.8; }
  @media(max-width:700px) { .projects-intro { width:calc(100% - 2.25rem); padding-top:7.5rem; }.projects-intro h1 { font-size:clamp(2.8rem,14vw,5rem); } }
</style>
